#!/usr/bin/env bash

loadkeys ru
setfont cyr-sun16
timedatectl set-ntp true

echo -e "\e[96mНачало установки.\e[0m"


#--------------- Подготовка разделов ----------------
mkfs.fat -F 16 $EFI_PART
mkfs.ext4 -F $ROOT_PART

mount $ROOT_PART /mnt

mkdir -p /mnt/boot/efi
mount $EFI_PART /mnt/boot/efi

mkdir -p /mnt/home
mount $HOME_PART /mnt/home

# Переместить ВСЕ каталоги из /mnt/home в /mnt/home/old
mkdir -p /mnt/home/old-tmp
shopt -s nullglob
for d in /mnt/home/*/; do
  base="$(basename "${d%/}")"
  [ $d = /mnt/home/old-tmp/ ] && continue
  [ $d = /mnt/home/lost+found/ ] && continue
  mv $d /mnt/home/old-tmp/$base
done
mv /mnt/home/old-tmp /mnt/home/old

tune2fs -m 1 $ROOT_PART # 1% reserved space on /
tune2fs -m 0 $HOME_PART #remove root reserved space on /home


#--------------- Установка системы -------------------------
sed -i "s|Server = |#Server = |g" /etc/pacman.d/mirrorlist
echo 'Server = https://mirror.yandex.ru/archlinux/$repo/os/$arch' >> /etc/pacman.d/mirrorlist
pacman -S --refresh

echo -e "\e[96mПеремещение файлов.\e[0m"
mv /targetfs/rootfs/* /mnt/
mv /targetfs/homefs/* /mnt/home

PACKAGES=$(sed 's/#.*//' /root/pacman-packages.conf | sed '/^[[:space:]]*$/d' | xargs)
pacstrap -K /mnt $PACKAGES


#--------------- Настройка разделов -----------------------
genfstab -U /mnt > /mnt/etc/fstab
echo "tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0" >> /mnt/etc/fstab
echo "/.swap                                    none           swap    defaults,discard 0 0" >> /mnt/etc/fstab
echo "skyserver:/sky                            /sky           nfs     soft,intr,timeo=10,retry=3,_netdev,noatime,bg   0 0" >> /mnt/etc/fstab

fallocate -l 7629M /mnt/.swap # 8 GB = 7629 MiB
chmod 600 /mnt/.swap
mkswap /mnt/.swap


#--------------- Настройка системы -------------------------
arch-chroot /mnt /root/install-on-system

rm -rf /mnt/usr/share/grub/themes/starfield
rm -f /mnt/root/install-on-system


#--------------- Завершение --------------------------------
umount -R /mnt/boot/efi
umount -R /mnt/home
umount -R /mnt

echo "Установка завершена. Перезагрузите систему."
