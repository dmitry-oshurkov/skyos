#!/usr/bin/env bash


source /root/install-on-system.env

USER_HOME=/home/$USERNAME


#--------------- Настройка системы -----------------------------
# timezone and clock
ln -sf /usr/share/zoneinfo/$TIMEZONE /etc/localtime
hwclock --systohc

# todo use localectl

# locale
echo "en_US.UTF-8 UTF-8
ru_RU.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=ru_RU.UTF-8" > /etc/locale.conf

# console keymap
echo "KEYMAP=ru
FONT=cyr-sun16" > /etc/vconsole.conf

echo 'Section "InputClass"
  Identifier "system-keyboard"
  MatchIsKeyboard "on"
  Option "XkbLayout" "us,ru"
  Option "XkbVariant" ""
  Option "XkbOptions" "grp:alt_shift_toggle"
EndSection' > /etc/X11/xorg.conf.d/00-keyboard.conf


# hostname
echo "$HOSTNAME" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME

# Local
192.168.15.1         skyrouter
192.168.15.100       skyserver
192.168.15.150       beelink
127.0.0.1            bookstore.local
192.168.15.100       bookstore.sky
192.168.15.100       plugins.jetbrains.sky

#Other
89.187.169.39       image.tmdb.org
0.0.0.0             release.gitkraken.com
HOSTS


# root password
echo "root:$USER_PASSWORD" | chpasswd

# create user
groupadd -r autologin
useradd --create-home --user-group --groups wheel,kvm,docker,autologin $USERNAME
echo "$USERNAME:$USER_PASSWORD" | chpasswd
echo '%wheel ALL=(ALL) ALL' | EDITOR='tee -a' /usr/bin/visudo

useradd --create-home --user-group $USERNAME2
echo "$USERNAME2:$USER2_PASSWORD" | chpasswd

# enable multilib
sed -i 's|\#Color|Color|g' /etc/pacman.conf
sed -i 's|\#\[multilib\]|\[multilib\]|g' /etc/pacman.conf
sed -i '94s|\#Include|Include|g' /etc/pacman.conf
pacman -Sy --noprogressbar


#--------------- Установка AUR-пакетов -------------------------
mkdir -p $USER_HOME/.cache/yay
mv /var/tmp/aur-cache/* $USER_HOME/.cache/yay

mapfile -t ZST_FILES < <(find $USER_HOME/.cache/yay -type f -name '*.zst' ! -iname '*-debug*.zst' -print0 | xargs -0 -r -n1 echo)

pacman -U --needed --noconfirm --noprogressbar ${ZST_FILES[@]}


#--------------- Настройка системных приложений -------------------------
# lightdm
sed -i 's|#greeter-session=example-gtk-gnome|greeter-session=lightdm-slick-greeter|g' /etc/lightdm/lightdm.conf
sed -i 's|#greeter-setup-script=|greeter-setup-script=/usr/bin/numlockx on|g' /etc/lightdm/lightdm.conf # numlock on
sed -i 's|#logind-check-graphical=true|logind-check-graphical=true|g' /etc/lightdm/lightdm.conf # fix for system boots so fast
sed -i "s|#display-setup-script=|display-setup-script=xrandr -s $WORKING_RESOLUTION|g" /etc/lightdm/lightdm.conf
# slick-greeter
echo "[Greeter]" > /etc/lightdm/slick-greeter.conf
echo "background=/usr/share/backgrounds/linuxmint-serena/capelli_ears_of_corn.jpg" >> /etc/lightdm/slick-greeter.conf
echo "theme-name=Sky-Mint-Y-Dark-Aqua" >> /etc/lightdm/slick-greeter.conf
echo "icon-theme-name=Newaita-reborn-mint-dark" >> /etc/lightdm/slick-greeter.conf
echo "cursor-theme-name=Empty-Butterfly-Yellow-vr1" >> /etc/lightdm/slick-greeter.conf
echo "clock-format=%H:%M     %e %B, %A" >> /etc/lightdm/slick-greeter.conf
echo "draw-user-backgrounds=false" >> /etc/lightdm/slick-greeter.conf
echo "draw-grid=true" >> /etc/lightdm/slick-greeter.conf
echo "activate-numlock=true" >> /etc/lightdm/slick-greeter.conf
echo "show-a11y=false" >> /etc/lightdm/slick-greeter.conf


# applications category
echo "[Desktop Entry]
Name=RemoteAndVMs
Comment=Remote connections and VMs
Name[ru]=Подключения и ВМ
Comment[ru]=Удалённые подключения и виртуальные машины
Icon=AppImage
Type=Directory" > /usr/share/desktop-directories/remote-and-vm.directory

mkdir --parents /etc/xdg/menus/applications-merged
echo "<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>RemoteAndVMs</Name>
    <Directory>remote-and-vm.directory</Directory>
    <Include>
      <Category>RemoteAndVMs</Category>
    </Include>
  </Menu>
</Menu>" > /etc/xdg/menus/applications-merged/remote-and-vm.menu


# sudo
echo "Defaults passwd_timeout=0" >> /etc/sudoers
echo "Defaults timestamp_timeout=15" >> /etc/sudoers

# all cores for aur builds
sed -i 's|#MAKEFLAGS="-j2"|MAKEFLAGS="-j$(nproc)"|g' /etc/makepkg.conf


# docker
mkdir -p /home/docker
mkdir -p /etc/docker
rm -rf /var/lib/docker
echo $'{
"data-root": "/home/docker",
"registry-mirrors": [
        "https://dockerhub.timeweb.cloud",
        "https://dh-mirror.gitverse.ru",
        "https://mirror.gcr.io",
        "https://daocloud.io",
        "https://c.163.com/",
        "https://registry.docker-cn.com",
        "https://huecker.io"
    ]
}' > /etc/docker/daemon.json
# todo nvidia
# nvidia-ctk runtime configure --runtime=docker

echo "options overlay metacopy=off redirect_dir=off" > /etc/modprobe.d/disable-overlay-redirect-dir.conf
# todo check
# modprobe --remove overlay
# modprobe overlay


# nginx
echo "
events {
    multi_accept on;
    worker_connections 1024;
}

http {
    client_max_body_size 0;

    server {
        listen 80;
        server_name bookstore.local;

        location / {
            proxy_pass http://localhost:8094/;
        }
    }
}
" > /etc/nginx/nginx.conf


# rsync (100 Мегабит = 12500 Килобайт)
echo $'#!/usr/bin/env bash' > /etc/NetworkManager/dispatcher.d/sync-$USERNAME-files
echo "
if [ x\"\$2\" = \"xup\" ] ; then
    cp --force $USER_HOME/.ssh/known_hosts /root/.ssh/known_hosts
    /usr/bin/rsync --rsh='/usr/bin/sshpass -f $USER_HOME/.ssh/skyserver ssh -o StrictHostKeyChecking=no -l $USERNAME' --archive --verbose --compress --delete --bwlimit=12500 --log-file=/tmp/sync-$USERNAME-files.log $USER_HOME/Видео/Домашнее/Готовые/ $USERNAME@skyserver:/sky/videos/home/release
    /usr/bin/rsync --rsh='/usr/bin/sshpass -f $USER_HOME/.ssh/skyserver ssh -o StrictHostKeyChecking=no -l $USERNAME' --archive --verbose --compress --delete --bwlimit=12500 --log-file=/tmp/sync-$USERNAME-files.log $USER_HOME/Видео/Домашнее/Источники/ $USERNAME@skyserver:/sky/videos/home/src
    /usr/bin/rsync --rsh='/usr/bin/sshpass -f $USER_HOME/.ssh/skyserver ssh -o StrictHostKeyChecking=no -l $USERNAME' --archive --verbose --compress --delete --bwlimit=12500 --log-file=/tmp/sync-$USERNAME-files.log $USER_HOME/Фотографии/ $USERNAME@skyserver:/sky/photos
    /usr/bin/rsync --rsh='/usr/bin/sshpass -f $USER_HOME/.ssh/skyserver ssh -o StrictHostKeyChecking=no -l $USERNAME' --archive --verbose --compress --delete --bwlimit=12500 --log-file=/tmp/sync-$USERNAME-files.log $USER_HOME/Музыка/ $USERNAME@skyserver:/sky/music
fi
" >> /etc/NetworkManager/dispatcher.d/sync-$USERNAME-files
chown -R root:root /etc/NetworkManager/dispatcher.d/sync-$USERNAME-files
chmod +x /etc/NetworkManager/dispatcher.d/sync-$USERNAME-files


# ignore packages update
#пока не нужно sed -i "s|#IgnorePkg   =|IgnorePkg = linux-lts linux-lts-headers cryptopro-csp-k1 icaclient|g" /etc/pacman.conf


