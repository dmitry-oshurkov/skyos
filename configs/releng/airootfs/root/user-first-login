#!/usr/bin/env bash

sleep 5

#--------------- Setup desktop -------------
sed -i 's|"%A, %B %e, %H:%M"|"%H:%M     %e %B, %A"|g' $HOME/.config/cinnamon/spices/calendar@cinnamon.org/12.json
sed -i '25s|false|true|g' $HOME/.config/cinnamon/spices/calendar@cinnamon.org/12.json
sed -i '188s|true|false|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # show-desktop.value
sed -i '200s|true|false|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # show-downloads.value
sed -i '224s|true|false|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # show-bookmarks.value
sed -i '255s|24|32|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # sidebar-icon-size.value
sed -i '331s|665|730|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # popup-width.value
sed -i '336s|425|625|g' $HOME/.config/cinnamon/spices/menu@cinnamon.org/0.json # popup-height.value
sed -i 's|"value": "visual"|"value": "buttons"|g' $HOME/.config/cinnamon/spices/workspace-switcher@cinnamon.org/17.json
sed -i '14d' $HOME/.config/cinnamon/spices/panel-launchers@cinnamon.org/13.json
sed -i '14d' $HOME/.config/cinnamon/spices/panel-launchers@cinnamon.org/13.json
sed -i '14s|"nemo.desktop"|"org.gnome.SystemMonitor.desktop",\n"org.gnome.Terminal.desktop",\n"org.gnome.Calculator.desktop",\n"org.gnome.Screenshot.desktop",\n"deluge.desktop",\n"org.gnome.meld.desktop",\n"postman.desktop",\n"bitwarden.desktop",\n"codium.desktop",\n"video-collector-client.desktop"|g' $HOME/.config/cinnamon/spices/panel-launchers@cinnamon.org/13.json

echo '{"width":{"type":"scale","default":10,"min":2,"max":400,"step":1,"value":7},"__md5__":"ce7d0d70f40859fec53e8c70cde93a17"}
' > $HOME/.config/cinnamon/spices/spacer@cinnamon.org/23.json
cp $HOME/.config/cinnamon/spices/spacer@cinnamon.org/23.json $HOME/.config/cinnamon/spices/spacer@cinnamon.org/24.json
cp $HOME/.config/cinnamon/spices/spacer@cinnamon.org/23.json $HOME/.config/cinnamon/spices/spacer@cinnamon.org/25.json
