#!/usr/bin/env bash

echo -e "\e[1;32mСоздание снимка Timeshift...\e[0m"

if sudo timeshift --create --comments "Перед обновлением системы"; then

    echo
    echo -e "\e[1;32mСнимок успешно создан.\e[0m"
    echo -e "\e[1;32mЗапуск обновления yay...\e[0m"
    echo

    yay

    status=$?

    echo
    if [ "$status" -eq 0 ]; then
        echo -e "\e[1;32mОбновление завершено успешно.\e[0m"
    else
        echo -e "\e[1;31mОбновление завершено с ошибкой.\e[0m"
    fi

else
    echo
    echo -e "\e[1;31mОшибка: снимок Timeshift не создан.\e[0m"
    echo -e "\e[1;31mОбновление отменено.\e[0m"
    read -r -p $'\e[1;31mНажмите Enter для выхода...\e[0m' _
    exit 1
fi

echo
read -r -p $'\e[1;32mНажмите Enter для выхода...\e[0m' _
exit "$status"
