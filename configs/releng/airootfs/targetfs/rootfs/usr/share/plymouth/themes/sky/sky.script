# Черный фон
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# Логотип должен находиться рядом со скриптом
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

# Разместить логотип по центру экрана
logo_sprite.SetPosition(
    (Window.GetWidth() - logo_image.GetWidth()) / 2,
    (Window.GetHeight() - logo_image.GetHeight()) / 2,
    0
);
