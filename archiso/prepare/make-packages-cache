#!/usr/bin/env bash

pacman-cache() {
    mkdir -p /targetfs/rootfs/var/cache/pacman/pkg
    cp /targetfs/rootfs/var/cache/pacman/pkg/*.{zst,zst.sig} /var/cache/pacman/pkg

    mapfile -t PACMAN_PACKAGES_ARR < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' /root/pacman-packages.conf)

    PACMAN_PACKAGES=$(sed 's/#.*//' /root/pacman-packages.conf | sed '/^[[:space:]]*$/d' | xargs)
    pacman -S --needed --noconfirm --noprogressbar $PACMAN_PACKAGES
}

aur-cache() {
    mv /root/bin /tmp

    #--------------- Временный пользователь -------------------------
    useradd -m -s /bin/bash -G wheel auruser
    mkdir -p /etc/sudoers.d
    echo "auruser ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/auruser && chmod 440 /etc/sudoers.d/auruser

    mkdir -p /targetfs/homefs/user/.cache/yay
    mkdir -p /home/auruser/.cache/yay
    rsync -r /targetfs/homefs/user/.cache/yay/ /home/auruser/.cache/yay/
    chown -R auruser:auruser /home/auruser

    sed -i "s|debug lto)|!debug lto !autodeps)|g" /etc/makepkg.conf
    sed -i "s|-T0 -)|-T0 -9 -)|g" /etc/makepkg.conf

    #--------------- Установка --------------------------------------
    if [ ! -d /home/auruser/.cache/yay/yay-bin/.git ]; then
        sudo -u auruser bash -lc "
          git clone --quiet https://aur.archlinux.org/yay-bin.git ~/.cache/yay/yay-bin
          cd ~/.cache/yay/yay-bin
          makepkg --syncdeps --install --noconfirm --noprogressbar"
    else
        pacman -U --needed --noconfirm --noprogressbar /home/auruser/.cache/yay/yay-bin/yay-bin-*-x86_64.pkg.tar.zst
    fi

    if [ ! -d /home/auruser/.cache/yay/intellij-idea-ultimate-edition/.git ]; then
        sudo -u auruser bash -lc "
          git clone --quiet https://aur.archlinux.org/intellij-idea-ultimate-edition.git ~/.cache/yay/intellij-idea-ultimate-edition
          cd ~/.cache/yay/intellij-idea-ultimate-edition
          sed -i 's|download.jetbrains.com|download-cdn.jetbrains.com|g' ./PKGBUILD
          git config user.name 'you@example.com'
          git config user.email 'you@example.com'
          git commit -a -m 'use cdn'"
    fi

    if [ ! -d /home/auruser/.cache/yay/gitkraken/.git ]; then
        sudo -u auruser bash -lc "
          git clone --quiet https://aur.archlinux.org/gitkraken.git ~/.cache/yay/gitkraken
          cd ~/.cache/yay/gitkraken
          sed -i 's|\"eula.html\"|\"eula.html\"\\n\"https://gitflic.ru/project/skylab/bookstore/release/aff938ee-7571-4846-b2e1-a5e528737ab6/ab261d54-6a17-47cb-8f6f-46e6972371b5/download\"|g' ./PKGBUILD
          sed -i \"s|'5b7b39b331bc32a606e1e79c695df4519c9b220225be00fb34ef368c3af319a6')|'5b7b39b331bc32a606e1e79c695df4519c9b220225be00fb34ef368c3af319a6'\n'SKIP')|g\" ./PKGBUILD
          sed -i '73i cd ./gtkrn-patch' ./PKGBUILD
          sed -i '74i sed -i \"s|/opt/gitkraken|\$pkgdir/opt/gitkraken|g\" ./src/patcher.ts' ./PKGBUILD
          sed -i '75i yarn install' ./PKGBUILD
          sed -i '76i yarn build' ./PKGBUILD
          sed -i '77i node ./dist/bin/gitcracken-patcher.js' ./PKGBUILD
          git config user.name 'you@example.com'
          git config user.email 'you@example.com'
          git commit -a -m 'use patch'"
    fi

    rm -rf /home/auruser/.cache/yay/cryptopro-csp-k1
    sudo -u auruser bash -lc "
      git clone --quiet https://aur.archlinux.org/cryptopro-csp-k1.git ~/.cache/yay/cryptopro-csp-k1
      cd ~/.cache/yay/cryptopro-csp-k1
      sed -i 's|^pkgver=.*|pkgver=5.0.13000|g' ./PKGBUILD
      sed -i 's|^_cades_version=.*|_cades_version=\"2.0.15000-1\"|g' ./PKGBUILD
      sed -i 's|7812c70bee0cf88328d689d78d769bca945779b9979369fb120adb7833f428f5|SKIP|g' ./PKGBUILD
      sed -i 's|local://linux-amd64.tgz|file:///tmp/bin/linux-amd64.tgz|g' ./PKGBUILD
      git config user.name 'you@example.com'
      git config user.email 'you@example.com'
      git commit -a -m 'use fix'"

    mapfile -t PACKAGES_ARR < <(sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' /root/aur-packages.conf)

    for pkg in "${PACKAGES_ARR[@]}"; do
      sudo -u auruser bash -lc "yay -S --quiet --needed --noconfirm --noprogressbar $pkg"
    done

    rm -rf /home/auruser/.cache/yay/cryptopro-csp-k1/pkg
    rm -rf /home/auruser/.cache/yay/cryptopro-csp-k1/src
    rm -rf /home/auruser/.cache/yay/intellij-idea-ultimate-edition/pkg
    rm -rf /home/auruser/.cache/yay/intellij-idea-ultimate-edition/src
    rm -rf /home/auruser/.cache/yay/qjournalctl/pkg
    rm -rf /home/auruser/.cache/yay/qjournalctl/src
    rm -rf /home/auruser/.cache/yay/yandex-browser/src
    rm -f /home/auruser/.cache/yay/gitkraken/pkg/gitkraken/opt/gitkraken/resources/app.asar.*.backup

    rsync --quiet --recursive /home/auruser/.cache/yay/ /targetfs/homefs/user/.cache/yay/
}

custom() {
    rm -f /targetfs/rootfs/etc/hosts
    rm -rf /targetfs/rootfs/var/tmp/skyos
    mkdir -p /targetfs/rootfs/var/tmp/skyos

    curl -sL -o /targetfs/rootfs/etc/hosts https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts # check
    curl -sLO --output-dir /targetfs/rootfs/var/tmp/skyos https://open-vsx.org/api/MS-CEINTL/vscode-language-pack-ru/1.121.0/file/MS-CEINTL.vscode-language-pack-ru-1.121.0.vsix
}

pacman-cache
aur-cache
custom

rm -rf /var/cache/pacman/pkg/download*
pacman -S --clean --noconfirm

mv /var/cache/pacman/pkg/*.{zst,zst.sig} /targetfs/rootfs/var/cache/pacman/pkg
chmod -R a+w /targetfs

echo make-packages-cache completed
